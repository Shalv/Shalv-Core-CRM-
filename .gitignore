# Dependencies
node_modules/

# Build output (regenerated by `npm run build`; Vercel rebuilds from source via vercel.json)
dist/

# Local environment secrets — .env.example is the tracked template, never commit real values
.env
.env.local
.env.*.local

# Logs and scratch
*.log
npm-debug.log*
.npm/
.tmp/

# OS and editor
.DS_Store
.idea/
.vscode/

# NOTE: .vercel/output/ is intentionally NOT ignored here because 55 files under it are
# already tracked in this repo's history. A gitignore rule has no effect on tracked files,
# so adding one would only create a confusing half-state. To stop committing build
# artifacts, untrack them first:  git rm -r --cached .vercel/output
# .vercel/output/
