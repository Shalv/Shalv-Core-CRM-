# Dependencies
node_modules/

# Build output (regenerated by `npm run build`; Vercel rebuilds from source via vercel.json)
dist/

# Local environment secrets — .env.example is the tracked template, never commit real values
.env
.env.local
.env.*.local

# Logs and scratch
*.log
npm-debug.log*
.npm/
.tmp/

# OS and editor
.DS_Store
.idea/
.vscode/

# Vercel build output, regenerated by `npm run build` (scripts/build-api.mjs writes .vercel/output).
# These artifacts were committed to this repo until it was untracked; keeping it out of git means
# what ships is always freshly built from source, so a deployment can no longer silently serve a
# stale committed bundle. `.vercel/project.json` (project/org ids) stays local too.
# Caveat: tests/deployment.test.cjs reads .vercel/output, so run `npm run build` before
# `npm run test:deployment` on a fresh clone — `npm run check` already does the build first.
.vercel/
