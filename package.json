{
  "name": "enact360-crm",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-api.mjs",
    "postbuild": "node scripts/build-api.mjs",
    "start": "NODE_ENV=production node --import tsx server.ts --production",
    "preview": "NODE_ENV=production node --import tsx server.ts --production",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run lint && npm test && npm run build && npm run test:deployment",
    "test:deployment": "node --test tests/deployment.test.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "react-test-renderer": "^19.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
