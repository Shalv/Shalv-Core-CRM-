{
  "version": 3,
  "routes": [
    {
      "src": "^(/api(?:/.*)?)$",
      "dest": "/api?__enact_path=$1"
    },
    {
      "src": "^(/auth(?:/.*)?)$",
      "dest": "/api?__enact_path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}